                    "argument": "Olympic Winter Games Milano Cortina 2026"
                },
                {
                    "role": "Result",
                    "argument": "2-1 in overtime"
                }
            ]
        },
        {
            "event_id": "E3",
            "event_mention": "It marks the third Olympic gold medal for the United States in men’s ice hockey, and the first since their win in Upstate New York.",
            "event_type": "Award",
            "trigger": "marks",
            "arguments": [
                {
                    "role": "Agent",
