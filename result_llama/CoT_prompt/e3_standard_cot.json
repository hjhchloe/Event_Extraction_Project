        {
            "event_id": "E2",
            "event_mention": "Forty-six years to the day after the \"Miracle on Ice*\"* team played their way into ice hockey lore at Lake Placid 1980, the United States created a new Olympic memory for fans to dream about, defeating Canada 2-1 in overtime in the men’s final at Olympic Winter Games Milano Cortina 2026 on Sunday (22 February).",
            "event_type": "Sports Competition",
            "trigger": "defeating",
            "arguments": [
                {
                    "role": "Agent",
                    "argument": "United States"
                },
                {
                    "role": "Agent",
