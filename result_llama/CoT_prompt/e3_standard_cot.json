                    "argument": "third Olympic gold medal"
                }
            ]
        },
        {
            "event_id": "E4",
            "event_mention": "Jack Hughes was the hero, scoring the golden goal in overtime to secure gold for the Americans.",
            "event_type": "Scoring",
            "trigger": "scoring",
            "arguments": [
                {
                    "role": "Agent",
                    "argument": "Jack Hughes"
