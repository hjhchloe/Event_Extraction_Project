        },
        {
            "event_id": "E8",
            "event_type": "Advice",
            "event_mention": "[My mom] said, 'You’ve landed this run five times in training. It’s there, stop thinking so much.'",
            "trigger": "said",
            "arguments": [
                {
                    "role": "Speaker",
                    "argument": "Yan"
